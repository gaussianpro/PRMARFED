# ============================================================
# Jones Act DSGE – policy vectors, moments, FEVD, IRFs
# ============================================================
import numpy as np
from numpy.linalg import solve
import pandas as pd
import matplotlib.pyplot as plt

# ------------------------------------------------------------
# Parameters
# ------------------------------------------------------------
beta       = 0.99
xi         = 0.75
kappa      = (1 - xi)*(1 - beta*xi)/xi
sigma      = 2.0
lam        = 0.42
sigma_eff  = sigma/(1 - lam)
omega_AD   = 0.58
Theta_ToT  = 0.45
Gamma_tr   = 0.15
alpha      = 0.33
phi_pi     = 1.8
gamma_dir  = 0.142
theta_fuel = 0.50
psi_s      = 0.30
psi_y      = 0.08

rho   = np.array([0.684, 0.773, 0.739, 0.900, 0.869, 0.811])
sigma_shocks = np.array([0.0129, 0.0051, 0.1308, 0.0020, 0.0302, 0.0312])
names = ['a (tech)', 'pi*', 'oil', 'nu_i', 'tr', 'ship']

# ------------------------------------------------------------
# Policy-vector solver
# ------------------------------------------------------------
def solve_policy(tau_JA, psi_s_val, label=""):
    gamma = gamma_dir + tau_JA * theta_fuel

    def forcing(j):
        if j == 0:   phi_mc = -(1 - alpha)
        elif j == 1: phi_mc = +alpha
        elif j == 2: phi_mc = +alpha * gamma
        elif j == 5: phi_mc = +alpha * psi_s_val
        else:        phi_mc = 0.0
        D_pi = kappa * phi_mc

        rr = omega_AD / sigma_eff
        if j == 0:   D_y = 0.0
        elif j == 1: D_y = -rr * phi_pi
        elif j == 2: D_y = -Theta_ToT * gamma
        elif j == 3: D_y = -rr
        elif j == 4: D_y = +Gamma_tr
        elif j == 5: D_y = -Theta_ToT * psi_s_val
        else:        D_y = 0.0
        return D_pi, D_y

    C_pi = np.zeros(6)
    C_y  = np.zeros(6)
    for j in range(6):
        r = rho[j]
        D_pi, D_y = forcing(j)
        A = np.array([
            [1 - beta*r,   -kappa * psi_y],
            [r / sigma_eff, 1 - r        ]
        ])
        sol = solve(A, np.array([D_pi, D_y]))
        C_pi[j], C_y[j] = sol[0], sol[1]

    print("="*65)
    print(f"POLICY VECTORS – {label}")
    print(f"τ_JA = {tau_JA:.3f}   γ = {gamma:.4f}   ψ_s = {psi_s_val:.2f}   ψ_y = {psi_y}")
    print("="*65)
    print(f"{'Shock':<12} {'C_pi':>10} {'C_y':>10}")
    print("-"*35)
    for j, n in enumerate(names):
        print(f"{n:<12} {C_pi[j]:10.4f} {C_y[j]:10.4f}")
    print("\nC_pi =", np.round(C_pi, 4))
    print("C_y  =", np.round(C_y, 4))
    print()
    return C_pi, C_y

# ------------------------------------------------------------
# Baseline and Repeal
# ------------------------------------------------------------
C_pi_b, C_y_b = solve_policy(0.071, 0.30, "BASELINE")
C_pi_r, C_y_r = solve_policy(0.000, 0.00, "REPEAL")

# ------------------------------------------------------------
# Asymptotic moments (baseline)
# ------------------------------------------------------------
C_pi = C_pi_b
C_y  = C_y_b
sig  = sigma_shocks

var_y  = np.sum((C_y  * sig)**2 / (1 - rho**2))
var_pi = np.sum((C_pi * sig)**2 / (1 - rho**2))
std_y, std_pi = np.sqrt(var_y), np.sqrt(var_pi)
auto_y  = np.sum((C_y  * sig)**2 * rho / (1 - rho**2)) / var_y
auto_pi = np.sum((C_pi * sig)**2 * rho / (1 - rho**2)) / var_pi
corr_ypi = np.sum(C_y * C_pi * sig**2 / (1 - rho**2)) / (std_y * std_pi)

print("="*65)
print("ASYMPTOTIC BUSINESS CYCLE MOMENTS (Baseline)")
print("="*65)
print(f"{'σ(y)':<35} {std_y:12.4f}")
print(f"{'σ(π)':<35} {std_pi:12.4f}")
print(f"{'ρ(y_t,y_{t-1})':<35} {auto_y:12.4f}")
print(f"{'ρ(π_t,π_{t-1})':<35} {auto_pi:12.4f}")
print(f"{'Corr(y,π)':<35} {corr_ypi:12.4f}")
print("\nContribution to asymptotic output variance (%):")
for n, s in zip(names, 100*(C_y*sig)**2/(1-rho**2)/var_y):
    print(f"  {n:<12}: {s:6.2f}%")
print()

# ------------------------------------------------------------
# FEVD helpers
# ------------------------------------------------------------
def fevd(C, horizons=[1,4,8,20]):
    out = {}
    for H in horizons:
        cum = np.zeros(6)
        for h in range(H):
            cum += (C * (rho**h) * sig)**2
        out[H] = 100 * cum / cum.sum()
    return out

def asy(C):
    v = (C * sig)**2 / (1 - rho**2)
    return 100 * v / v.sum()

fevd_y_b, fevd_pi_b = fevd(C_y_b), fevd(C_pi_b)
asy_y_b, asy_pi_b   = asy(C_y_b), asy(C_pi_b)
asy_y_r, asy_pi_r   = asy(C_y_r), asy(C_pi_r)

print("="*75)
print("TABLE 4 – Finite-horizon FEVD – BASELINE (%)")
print("="*75)
print("\nPanel A: Output Gap")
print(pd.DataFrame({
    'Horizon': ['Q1','Q4','Q8','Q20'],
    'Tech':      [fevd_y_b[h][0] for h in [1,4,8,20]],
    'US Infl':   [fevd_y_b[h][1] for h in [1,4,8,20]],
    'Oil':       [fevd_y_b[h][2] for h in [1,4,8,20]],
    'Fed Rate':  [fevd_y_b[h][3] for h in [1,4,8,20]],
    'Transfers': [fevd_y_b[h][4] for h in [1,4,8,20]],
    'Shipping':  [fevd_y_b[h][5] for h in [1,4,8,20]],
}).round(2).to_string(index=False))

print("\nPanel B: Inflation")
print(pd.DataFrame({
    'Horizon': ['Q1','Q4','Q8','Q20'],
    'Tech':      [fevd_pi_b[h][0] for h in [1,4,8,20]],
    'US Infl':   [fevd_pi_b[h][1] for h in [1,4,8,20]],
    'Oil':       [fevd_pi_b[h][2] for h in [1,4,8,20]],
    'Fed Rate':  [fevd_pi_b[h][3] for h in [1,4,8,20]],
    'Transfers': [fevd_pi_b[h][4] for h in [1,4,8,20]],
    'Shipping':  [fevd_pi_b[h][5] for h in [1,4,8,20]],
}).round(2).to_string(index=False))

print("\n" + "="*75)
print("TABLE 5 – Asymptotic FEVD – Baseline vs Repeal (%)")
print("="*75)
print(pd.DataFrame({
    'Tech':      [asy_y_b[0], asy_pi_b[0], asy_y_r[0], asy_pi_r[0]],
    'US Infl':   [asy_y_b[1], asy_pi_b[1], asy_y_r[1], asy_pi_r[1]],
    'Oil':       [asy_y_b[2], asy_pi_b[2], asy_y_r[2], asy_pi_r[2]],
    'Fed Rate':  [asy_y_b[3], asy_pi_b[3], asy_y_r[3], asy_pi_r[3]],
    'Transfers': [asy_y_b[4], asy_pi_b[4], asy_y_r[4], asy_pi_r[4]],
    'Shipping':  [asy_y_b[5], asy_pi_b[5], asy_y_r[5], asy_pi_r[5]],
}, index=['Baseline Output','Baseline Inflation','Repeal Output','Repeal Inflation']).round(2))

# ------------------------------------------------------------
# Standardized IRFs
# ------------------------------------------------------------
horizon = 20
h = np.arange(horizon)
shock_names = ['Technology','US Inflation','Oil Price','FFR','Transfers','Shipping']

def irf(C, j):
    return C[j] * (rho[j] ** h)

fig, axes = plt.subplots(2, 3, figsize=(14, 8), sharex=True)
axes = axes.flatten()
for j in range(6):
    ax = axes[j]
    ax.plot(h, irf(C_y_b, j), 'b-',  lw=2, label='Baseline')
    ax.plot(h, irf(C_y_r, j), 'r--', lw=2, label='Repeal')
    ax.axhline(0, color='k', lw=0.7, alpha=0.5)
    ax.set_title(shock_names[j])
    ax.grid(True, alpha=0.3)
    if j == 0: ax.legend(fontsize=9)
    if j >= 3: ax.set_xlabel('Quarters')
    ax.set_ylabel('Output Gap')
fig.suptitle('Standardized IRFs – Output Gap (Baseline vs Repeal)', fontsize=14)
plt.tight_layout()
plt.savefig('IRF_Output_Final.png', dpi=300, bbox_inches='tight')
plt.show()

fig, axes = plt.subplots(2, 3, figsize=(14, 8), sharex=True)
axes = axes.flatten()
for j in range(6):
    ax = axes[j]
    ax.plot(h, irf(C_pi_b, j), 'b-',  lw=2, label='Baseline')
    ax.plot(h, irf(C_pi_r, j), 'r--', lw=2, label='Repeal')
    ax.axhline(0, color='k', lw=0.7, alpha=0.5)
    ax.set_title(shock_names[j])
    ax.grid(True, alpha=0.3)
    if j == 0: ax.legend(fontsize=9)
    if j >= 3: ax.set_xlabel('Quarters')
    ax.set_ylabel('Inflation')
fig.suptitle('Standardized IRFs – Inflation (Baseline vs Repeal)', fontsize=14)
plt.tight_layout()
plt.savefig('IRF_Inflation_Final.png', dpi=300, bbox_inches='tight')
plt.show()

